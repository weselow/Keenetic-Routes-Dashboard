#!/bin/sh
# VPN Routes Dashboard - Init script
# Starts lighttpd web server on port 8080

NAME="vpn-routes-web"
DESC="VPN Routes Dashboard"
DAEMON="/opt/sbin/lighttpd"
CONF="/opt/etc/lighttpd/vpn-routes.conf"
PIDFILE="/opt/var/run/vpn-routes-web.pid"

start() {
    if [ ! -x "$DAEMON" ]; then
        echo "ERROR: lighttpd not found. Install: opkg install lighttpd lighttpd-mod-cgi"
        return 1
    fi

    if [ ! -f "$CONF" ]; then
        echo "ERROR: Config not found: $CONF"
        return 1
    fi

    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
        echo "$DESC is already running"
        return 0
    fi

    echo "Starting $DESC..."
    $DAEMON -f "$CONF"

    sleep 1
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
        echo "$DESC started on port 8080"
        return 0
    else
        echo "ERROR: Failed to start $DESC"
        return 1
    fi
}

stop() {
    if [ ! -f "$PIDFILE" ]; then
        echo "$DESC is not running"
        return 0
    fi

    echo "Stopping $DESC..."
    kill $(cat "$PIDFILE") 2>/dev/null
    rm -f "$PIDFILE"
    echo "$DESC stopped"
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
        echo "$DESC is running (PID: $(cat $PIDFILE))"
        echo "URL: http://$(ip addr show br0 2>/dev/null | grep 'inet ' | awk '{print $2}' | cut -d/ -f1 | head -1):8080"
        return 0
    else
        echo "$DESC is not running"
        return 1
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
